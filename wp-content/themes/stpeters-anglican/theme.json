{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "paper", "name": "Paper", "color": "#FBF7F0" },
				{ "slug": "surface", "name": "Surface", "color": "#F4ECE0" },
				{ "slug": "stone", "name": "Stone", "color": "#E5DAC6" },
				{ "slug": "ink", "name": "Ink", "color": "#282219" },
				{ "slug": "evergreen", "name": "Parish Blue (deep)", "color": "#1F4E79" },
				{ "slug": "amber", "name": "Amber", "color": "#A9652F" },
				{ "slug": "brand", "name": "St. Peter's Blue", "color": "#3E8DDD" },
				{ "slug": "ivory", "name": "Ivory", "color": "#FDFBF4" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "body", "name": "Body", "fontFamily": "'Source Sans 3', sans-serif" },
				{ "slug": "display", "name": "Display", "fontFamily": "'Fraunces', serif" }
			],
			"fontSizes": [
				{ "name": "Small", "slug": "small", "size": "0.95rem", "fluid": { "min": "0.9rem", "max": "1rem" } },
				{ "name": "Medium", "slug": "medium", "size": "1.15rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "name": "Large", "slug": "large", "size": "1.5rem", "fluid": { "min": "1.375rem", "max": "1.625rem" } },
				{ "name": "X-Large", "slug": "x-large", "size": "2.125rem", "fluid": { "min": "1.75rem", "max": "2.375rem" } },
				{ "name": "Huge", "slug": "huge", "size": "3.25rem", "fluid": { "min": "2.5rem", "max": "4rem" } }
			],
			"fluid": true
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1180px"
		}
	},
	"styles": {
		"spacing": {
			"padding": {
				"left": "clamp(1.25rem, 4vw, 2.5rem)",
				"right": "clamp(1.25rem, 4vw, 2.5rem)"
			}
		},
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "600",
					"lineHeight": "1.08",
					"letterSpacing": "-0.015em"
				},
				"color": {
					"text": "var:preset|color|ink"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|evergreen"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": { "radius": "999px" }
			}
		}
	}
}
